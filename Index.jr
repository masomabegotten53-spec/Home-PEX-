const {
    default: makeWASocket,
    useMultiFileAuthState,
    DisconnectReason,
    fetchLatestBaileysVersion,
    makeCacheableSignalKeyStore,
    Browsers,
    downloadContentFromMessage
} = require('@whiskeysockets/baileys');
const { Boom } = require('@hapi/boom');
const pino = require('pino');
const fs = require('fs-extra');
const path = require('path');
const qrcode = require('qrcode-terminal');
const moment = require('moment-timezone');
const os = require('os');

// ==================== CONFIGURATION ====================
const ownerNumber = '27836547695@s.whatsapp.net';
const ownerName = 'Paxton';
const botName = 'Jarvis-MD-V2';
const devName = 'Paxton Mathebula';
const prefix = '.';
const sessionDir = './sessions';
const tempDir = './temp';
const databaseFile = './database.json';

// Create temp directory
if (!fs.existsSync(tempDir)) fs.mkdirSync(tempDir);

// Initialize database with all features
let database = {
    users: {},
    groups: {},
    economy: {},
    bans: [],
    filters: {},
    welcome: {},
    goodbye: {},
    antilink: {},
    antispam: {},
    commandStats: {},
    settings: {
        public: true,
        maintenance: false
    }
};

// Load existing database if available
if (fs.existsSync(databaseFile)) {
    try {
        const loaded = JSON.parse(fs.readFileSync(databaseFile));
        database = { ...database, ...loaded };
        if (!database.welcome) database.welcome = {};
        if (!database.goodbye) database.goodbye = {};
        if (!database.antilink) database.antilink = {};
        if (!database.commandStats) database.commandStats = {};
    } catch (e) {
        console.log('📁 Creating new database');
    }
}

const saveDatabase = () => {
    fs.writeFileSync(databaseFile, JSON.stringify(database, null, 2));
};

// ==================== BOT LOGO ====================
const botLogo = "https://i.postimg.cc/mrFR3WC0/1771259651391-015a2838-1c8e-4556-9706-d347e7e4b40d.png";

// ==================== HELPERS ====================
const isUrl = (text) => {
    return text.match(new RegExp(/https?:\/\/(www\.)?[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_\+.~#?&//=]*)/gi));
};

